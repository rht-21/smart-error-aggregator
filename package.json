  "license": "MIT",
  "description": "A lightweight package to aggregate and analyze JavaScript errors with actionable suggestions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rht-21/smart-error-aggregator.git"
  },
  "bugs": {
    "url": "https://github.com/rht-21/smart-error-aggregator/issues"
  },
  "homepage": "https://github.com/rht-21/smart-error-aggregator#readme",
  "devDependencies": {
    "@types/node": "^22.15.3",
